+static void reset_globals(void)
+{
+    Driver_Calibration_Password=997900UL;
+    CG_Param.CG_Zero_Left_Ad=1; CG_Param.CG_Max_Left_Ad=-12445;
+    CG_Param.CG_Zero_Right_Ad=50; CG_Param.CG_Max_Right_Ad=12513;
