+}
+
+static void test_record_boundaries_and_meta_rollback(void)
+{
+    EEP_NODE a;
+    uint16_t count;
+    unsigned before;
+    reset_all(); CHECK(Eep_Data_Get()==1);
+    CHECK(Eep_Input_Node(0U,node(0))==0);
+    CHECK(Eep_Input_Node(1U,node(1))==0);
+    mem[EEP_B3_NODE_SLOT_B+61U]^=0x10U;
