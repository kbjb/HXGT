+static void reset_all(void)
+{
+    memset(mem,0xFF,sizeof(mem)); reset_globals();
+    writes=reads=polls=page_crosses=writes_to_old=0;
+    fail_after_writes=fail_after_reads=-1; wp=bus_off=ack_timeout=0;
