+    CG_Param=(CG_Calibration_Param_Str){115,-17885,-115,17885,25};
+    CG_Data_Init(); CHECK(Get_CG_Value(-5000,25)==50.0f);
+}
+
+static void check_invalid(void)
+{
+    const CG_Calibration_Param_Str bad[] = {
