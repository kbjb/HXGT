+uint8_t Eep_Read_Legacy_Record(uint16_t index, void *node)
+{
+    EEP_NODE decoded;
+    uint8_t raw[EEP_NODE_ENCODED_LEN];
+    uint16_t old_addr;
+    if (node == NULL || index >= MAX_INDEX_ADDR) return 0U;
+    old_addr=(uint16_t)((uint32_t)index*EEP_NODE_ENCODED_LEN);
+    if (AT24C512_ReadBuffer(old_addr, raw, EEP_NODE_ENCODED_LEN)
+        != EEPROM_OK) return 0U;
+    DecodeNode(&decoded, raw);
+    memcpy(node, &decoded, sizeof(decoded));
+    return 1U;
+}
+
+uint8_t Eep_Import_Legacy_Records(uint16_t verified_count)
+{
+    uint16_t i, old_addr;
+    uint8_t raw[EEP_NODE_ENCODED_LEN], all_ff;
+    uint8_t j;
+    /* [B3] Service-only, requires operator backup and manual count.
+     * Will NEVER read/write the overlapping legacy node counters. */
+    if (!legacy_record_import_approved ||
+        record_state != EEP_RECORD_EMPTY ||
+        verified_count > MAX_INDEX_ADDR) return 0U;
+    for (i=0U; i<verified_count; ++i)
+    {
+        old_addr=(uint16_t)((uint32_t)i*EEP_NODE_ENCODED_LEN);
+        if (AT24C512_ReadBuffer(old_addr, raw, EEP_NODE_ENCODED_LEN)
+            != EEPROM_OK) return 0U;
+        all_ff=1U;
+        for (j=0U; j<EEP_NODE_ENCODED_LEN; ++j)
+            if (raw[j]!=0xFFU) {all_ff=0U; break;}
+        if (all_ff || !B3_WriteRecord(i, raw)) return 0U;
+    }
+    if (!B3_SaveRecordCount(verified_count)) return 0U;
+    legacy_record_import_approved=0U;
+    return 1U;
+}
