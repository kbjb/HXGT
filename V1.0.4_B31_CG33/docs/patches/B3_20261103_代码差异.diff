+uint8_t Eep_Approve_Legacy_Calibration_Upgrade(void)
+{
+    /* Must be explicitly invoked after an external 64KiB backup,
+     * review of GJ/CG/CH calibration and operator authorization.
+     * This does NOT modify EEPROM and is reset after reboot/save. */
+    if (cal_state != EEP_STATE_LEGACY_LOCKED) return 0U;
+    legacy_upgrade_approved=1U;
+    return 1U;
+}
+
+uint8_t Eep_Approve_Legacy_Record_Import(void)
+{
+    /* [B3] Independent authorization for importing historical records.
+     * Allowed after a full external backup and independently VERIFIED
+     * record count, even if calibration was upgraded earlier. */
+    if (record_state != EEP_RECORD_EMPTY ||
+        cal_state == EEP_STATE_IO_ERROR ||
+        cal_state == EEP_STATE_NOT_READY ||
+        cal_state == EEP_STATE_B3_CORRUPT) return 0U;
+    legacy_record_import_approved=1U;
+    return 1U;
+}
