--- /dev/null
+++ CG32/CG32_HOST_TESTS/test_filter.c
@@ -0,0 +1,40 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <assert.h>
+#include "cg_angle_filter.h"
+static unsigned checks = 0;
+#define CHECK(p) do { assert(p); checks++; } while(0)
+static void stabilize(CG_ANGLE_FILTER *f, int16_t v)
+{
+    int i;
+    for (i=0; i<35; ++i) CG_AngleFilter_Push(f,v);
+}
+int main(void)
+{
+    CG_ANGLE_FILTER f;
+    CG_AngleFilter_Init(&f);
+    CHECK(CG_AngleFilter_Push(&f,1500)==1500); /* never average 29 zeroes */
+    stabilize(&f,1500); CHECK(f.output_value==1500);
+    stabilize(&f,1502); CHECK(f.output_value==1500); /* <3 AD is held */
+    stabilize(&f,1503); CHECK(f.output_value==1503); /* >=3 AD updates */
+    CG_AngleFilter_Init(&f);
+    stabilize(&f,1500);
+    CG_AngleFilter_Push(&f,32767); /* one gross spike is trimmed */
+    CHECK(f.output_value==1500);
+    CG_AngleFilter_Push(&f,-32768); /* another gross spike is trimmed */
+    CHECK(f.output_value==1500);
+    CG_AngleFilter_Init(&f);
+    stabilize(&f,-32768); CHECK(f.filtered_value==-32768);
+    stabilize(&f,32767); CHECK(f.filtered_value==32767);
+    stabilize(&f,-12445); CHECK(f.output_value==-12445);
+    stabilize(&f,12513); CHECK(f.output_value==12513);
+    stabilize(&f,-12445); CHECK(f.output_value==-12445);
+    CG_AngleFilter_Init(&f);
+    stabilize(&f,600);
+    for (int v=601;v<=630;v++) {
+        stabilize(&f,(int16_t)v);
+        CHECK(f.output_value<=v && f.output_value>=v-2);
+    }
+    printf("CG32 filter: PASS (%u checks, -32768..32767, 3AD, spike/return)\n",checks);
+    return 0;
+}
--- /dev/null
+++ CG32/CG32_HOST_TESTS/test_adc.c
@@ -0,0 +1,27 @@
+#include <stdio.h>
+#include <assert.h>
+#include "adc161_head.h"
+static uint16_t raw_bits;
+static unsigned read_idx, clocks;
+static void write_gpio(Gpio *x,uint8_t v) { (void)x; (void)v; clocks++; }
+static uint8_t read_gpio(Gpio *x) {
+    (void)x;
+    assert(read_idx < 16U);
+    return (raw_bits >> (15U-read_idx++)) & 1U;
+}
+static void init_gpio(Gpio *x) { (void)x; }
+static Gpio gpio={write_gpio,read_gpio,init_gpio};
+int main(void) {
+    ADC161_STR f={&gpio,&gpio,&gpio,0,0,0,0};
+    const uint16_t raw[] = {0U,1U,0x7FFFU,0x8000U,0xFFFFU,0xBFA0U,0x4000U};
+    const int16_t expected[] = {0,1,32767,-32768,-1,-16480,16384};
+    for (unsigned i=0;i<sizeof(raw)/sizeof(raw[0]);i++) {
+        raw_bits=raw[i];read_idx=0U;clocks=0U;
+        ADC161_READ(&f);
+        assert(read_idx==16U && clocks==38U);
+        assert(f.ad_data==expected[i]);
+        assert(uint16_twos_complement_to_int16_original(raw[i])==expected[i]);
+    }
+    puts("CG32 ADC161 bitstream: PASS (7 full-sign cases, 18 clocks)");
+    return 0;
+}
